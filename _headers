# Sicherheits-Header für Netlify und Cloudflare Pages (andere Hoster: siehe .htaccess bzw. README.md › Hosting).
# Die Content-Security-Policy hier gilt für ALLE Pfade und erlaubt, was das Spiel (/play/) braucht
# (inline-Skripte der Einzeldatei, Supabase Realtime per WebSocket). Die Website-Seiten verschärfen sie zusätzlich
# per <meta http-equiv="Content-Security-Policy"> (keine inline-Skripte, keine WebSockets) – beide gelten gemeinsam.
# Erlaubte Fremdquellen: Clerk (Entwicklungsinstanz *.clerk.accounts.dev, Produktion clerk.<deine-domain>),
# Clerk-Profilbilder (img.clerk.com), Cloudflare Turnstile (Bot-Schutz von Clerk), Supabase (*.supabase.co).
# Schriften und Bibliotheken liegen lokal. Domain aetherfall.example durch die eigene ersetzen.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clerk.accounts.dev https://clerk.aetherfall.example https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.clerk.com; font-src 'self'; connect-src 'self' https://*.clerk.accounts.dev https://clerk.aetherfall.example https://*.supabase.co wss://*.supabase.co; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

/play/vendor/*
  Cache-Control: public, max-age=2592000
