# Aetherfall: Dungeons – Apache-Einstellungen für den Ordner /dungeons/ (iFastNet / cPanel: public_html/dungeons/.htaccess)
# Gilt nur für diesen Ordner; die Seite auf aetherfallroe.com/ (Realm of Embers) bleibt unberührt.
# Fehlerseite, Weiterleitungen, Sicherheits-Header und Caching. Liegt die Website woanders, Pfade /dungeons/ anpassen.
ErrorDocument 404 /dungeons/404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # immer HTTPS (auch hinter einem Proxy, der X-Forwarded-Proto setzt)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /dungeons/play → /dungeons/play/
  RewriteRule ^play$ /dungeons/play/ [L,R=301]
</IfModule>

<IfModule mod_alias.c>
  # Entwicklungsdateien nicht ausliefern, falls sie mit hochgeladen wurden
  RedirectMatch 404 (?i)^/dungeons/(supabase|\.git)(/|$)
  RedirectMatch 404 (?i)^/dungeons/README\.md$
</IfModule>

<IfModule mod_headers.c>
  # Content-Security-Policy für alle Pfade inkl. Spiel (/dungeons/play/: inline-Skripte der Einzeldatei, Supabase Realtime per
  # WebSocket); die Website-Seiten verschärfen sie per <meta http-equiv="Content-Security-Policy"> zusätzlich.
  # Erlaubte Fremdquellen: Clerk (Entwicklung *.clerk.accounts.dev, Produktion clerk.aetherfallroe.com), Clerk-Profilbilder
  # (img.clerk.com), Cloudflare Turnstile (Bot-Schutz von Clerk), Supabase (*.supabase.co). Schriften und Bibliotheken liegen lokal.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clerk.accounts.dev https://clerk.aetherfallroe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.clerk.com; font-src 'self'; connect-src 'self' https://*.clerk.accounts.dev https://clerk.aetherfallroe.com https://*.supabase.co wss://*.supabase.co; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # HSTS gilt für den ganzen Host aetherfallroe.com (auch die Hauptseite) – bewusst ohne includeSubDomains
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType text/vtt .vtt
  AddCharset utf-8 .html .css .js .json .webmanifest .vtt .txt .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/vtt application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/vtt "access plus 1 day"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
