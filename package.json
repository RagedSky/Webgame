{
  "name": "stellar-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stellar Archive – ein 3D-Entdecker-Spiel im Browser (Three.js, TypeScript, prozedural)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"docs/**/*.md\" \"*.{json,md,ts,js}\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
